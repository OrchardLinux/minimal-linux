# Native ARM64 apk verifies ARMv7 packages with the official ARMv7 signing keys.
FROM docker.io/library/alpine@sha256:6db0aa37b0f1ba86c31102b0972cb082a1d22ed1390440de84f1076d78d4d399 AS armkeys
FROM docker.io/library/alpine@sha256:e311ae748be7f56ae5cba304bc488f0786df68ee507513f654a5cc8597cffb42
COPY --from=armkeys /etc/apk/keys /armroot/etc/apk/keys
COPY --from=armkeys /etc/apk/keys /etc/apk/keys
RUN apk --root /armroot --arch armv7 --initdb --no-scripts \
    --keys-dir /etc/apk/keys --repositories-file /etc/apk/repositories \
    add busybox musl python3 dropbear nfs-utils util-linux e2fsprogs \
    && mkdir -p /armroot/bin \
    && cp /etc/apk/repositories /armroot/etc/apk/repositories \
    && cp -a /etc/apk/keys /armroot/etc/apk/keys \
    && for directory in bin sbin lib; do \
        mkdir -p "/armroot/usr/$directory"; \
        cp -a "/armroot/$directory/." "/armroot/usr/$directory/"; \
        rm -rf "/armroot/$directory"; \
        ln -s "usr/$directory" "/armroot/$directory"; \
       done \
    && test -f /armroot/usr/bin/python3 \
    && test -f /armroot/usr/sbin/blkid \
    && test -f /armroot/usr/sbin/sfdisk \
    && test -f /armroot/usr/sbin/mke2fs \
    && test -f /armroot/etc/mke2fs.conf \
    && test "$(readlink /armroot/lib)" = usr/lib \
    && test "$(readlink /armroot/bin)" = usr/bin \
    && test "$(readlink /armroot/sbin)" = usr/sbin
