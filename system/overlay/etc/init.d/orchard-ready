#!/sbin/openrc-run
description="Publish readiness once the required services run"
depend() { need orchard-platform orchard-ssh orchard-usb orchard-buttons; after orchard-splash; }
start() {
    ebegin "Checking minimal Linux readiness"
    /usr/libexec/minimal-ready
    eend $?
}
stop() { rm -f /run/minimal-linux-ready.json; }
