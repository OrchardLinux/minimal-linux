#!/sbin/openrc-run
description="USB network for the host: 172.16.42.1 here, DHCP hands out .2"
command="/usr/libexec/minimal-linux/busybox"
command_args="udhcpd -f /etc/udhcpd.conf"
command_background=true
pidfile="/run/orchard-dhcp.pid"
depend() { need orchard-session; }
start_pre() {
    # Started by orchard launch, nothing has configured orchard's USB network yet;
    # after the installer's handover the recovery already has.
    mkdir -p /run/recovery
    ip address show dev usb0 | grep -q 'inet ' && return 0
    ip address add 172.16.42.1/30 dev usb0 && ip link set usb0 up
}
