#!/bin/sh
# Ready on any Apple device orchard's platform layer runs on. No bring-up
# gates: the running kernel must be the layer's (its modules are installed),
# and the device an Apple one. Wi-Fi, Bluetooth and touch are reported, not
# required: experimental boards may lack some of them.
set -eu
[ -f "/usr/lib/modules/$(uname -r)/modules.dep" ]
case "$(tr '\000' '\n' < /proc/device-tree/compatible | head -1)" in apple,*) ;; *) exit 1 ;; esac
state() { if eval "$2"; then echo "$1: ready"; else echo "$1: missing"; fi; }
state wifi '[ -d /sys/class/net/wlan0 ]'
state bluetooth '[ -d /sys/class/bluetooth/hci0 ]'
state touch 'grep -q "^N: Name=\".*Touchscreen\"" /proc/bus/input/devices'
