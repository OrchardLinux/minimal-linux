# Alpine 3.24.3, official arm64 image (the same as system/Containerfile). Its native apk
# unpacks signed ARMv7 packages into /armroot and runs none of their code: no emulation.
FROM docker.io/library/alpine@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
COPY install-base /tmp/install-base
RUN sh /tmp/install-base && rm /tmp/install-base
